program RetReleaseWideRegister;
{$WARN unused-variable OFF}

// The implicit finally of a return lets go of managed registers numbered beyond the 256-register
// window: a string and an instance whose counts only drop (the fast path of `Ret`), and an
// instance whose last reference it holds (destroyed on return).

type
  TItem = class(TRefObject)
    Name: string;
    constructor Create(const AName: string);
    destructor Destroy; override;
  end;

constructor TItem.Create(const AName: string);
begin
  Name := AName;
end;

destructor TItem.Destroy;
begin
  WriteLn('destroy ', Name);
  inherited;
end;

