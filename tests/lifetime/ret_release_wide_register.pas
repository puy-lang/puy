var
  S: string;
  Item: TItem;
begin
  S := 'abc';
  Item := TItem.Create('kept');
  WriteLn(Use(S, Item, False));
  WriteLn(Use(S, Item, True));
  WriteLn(S, ' ', Item.Name);
end;

begin
  Run;
  WriteLn('end');
end.
