program DumpClassRefs
.type TShape = class(TObject) abstract
  .classvar g0 Count: Integer
  .method f0 Create constructor virtual 6
  .method - Area virtual 7
  .method f1 Name class virtual 8
  .method f2 Twice static
.type TShapeClass = class of TShape
.global g0 TShape.Count: Integer
.global g1 C: TShapeClass
.global g2 S: TShape
.routine f0 TShape.Create()
  .var v0 Self: TShape self
  inc @20 calc=Integer Q+R+
    global g0 TShape.Count
.routine f1 TShape.Name(): string
  .var v0 Self: TShapeClass self
  .var v1 Result: string result
  assign @25 R+
    var v1 Result
    builtin ClassName string
      self TShapeClass
.routine f2 TShape.Twice(N: Integer): Integer
  .var v0 N: Integer param
  .var v1 Result: Integer result
  assign @30 R+
    var v1 Result
    binary Integer
      var v0 N: Integer
      * Integer int:Integer
        const Integer 2
.routine <main>
  assign @37 R+
    global g1 C
    classref TShape
  assign @38 R+
    global g2 S
    create-of TShape virtual 6
      global g1 C: TShapeClass
  writeln @39
    arg
      class virtual 8 TShape.Name: string
        global g1 C: TShapeClass
    arg
      class virtual 8 TShape.Name: string
        builtin ClassType TClass
          global g2 S: TShape
    arg
      call f2 TShape.Twice: Integer
        global g0 TShape.Count: Integer
  free @40
    global g2 S: TShape
