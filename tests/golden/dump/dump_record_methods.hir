program DumpRecordMethods
.type TPoint = record
  .field 0 X: Integer
  .field 1 Y: Integer
  .method f0 Create constructor
  .method f1 Offset
  .method f2 Sum
  .property PX: Integer read=#0 write=#0
.routine f0 TPoint.Create(AX: Integer; AY: Integer)
  .var v0 Self: TPoint var self
  .var v1 AX: Integer param
  .var v2 AY: Integer param
  assign @19 R+
    field Integer X #0
      var v0 Self
    var v1 AX: Integer
  assign @20 R+
    field Integer Y #1
      var v0 Self
    var v2 AY: Integer
.routine f1 TPoint.Offset(DX: Integer)
  .var v0 Self: TPoint var self
  .var v1 DX: Integer param
  assign @25 R+
    field Integer X #0
      var v0 Self
    binary Integer
      field Integer X #0
        self TPoint
      + Integer int:Integer
        var v1 DX: Integer
.routine f2 TPoint.Sum(): Integer
  .var v0 Self: TPoint var self
  .var v1 Result: Integer result
  assign @30 R+
    var v1 Result
    binary Integer
      field Integer X #0
        self TPoint
      + Integer int:Integer
        field Integer Y #1
          self TPoint
.routine f3 Make(): TPoint
  .var v0 Result: TPoint result
  assign @35 R+
    var v0 Result
    create TPoint f0
      const Integer 1
      const Integer 2
.routine f4 Run(const C: TPoint)
  .var v0 C: TPoint const param
  .var v1 V: TPoint local
  .var v2 A: array of TPoint local
  assign @43 R+
    var v1 V
    var v0 C: TPoint
  setlength @44
    var v2 A
    const Int64 1
  expr @45
    call f1 TPoint.Offset: -
      ref
        var v1 V
      const Integer 1
  expr @46
    call f1 TPoint.Offset: -
      ref
        index TPoint
          var v2 A
          const Int64 0
      const Integer 2
  expr @47
    call f1 TPoint.Offset: -
      temp
        var v0 C: TPoint
      const Integer 3
  expr @48
    call f1 TPoint.Offset: -
      temp
        call f3 Make: TPoint
      const Integer 4
  writeln @49
    arg
      call f2 TPoint.Sum: Integer
        ref
          var v1 V
    arg
      const Char #32
    arg
      field Integer X #0
        index TPoint
          var v2 A: array of TPoint
          const Int64 0
.routine <main>
  expr @53
    call f4 Run: -
      create TPoint f0
        const Integer 5
        const Integer 6
