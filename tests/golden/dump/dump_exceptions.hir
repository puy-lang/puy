program DumpExceptions
.type EAppError = class(Exception)
.type EConfigError = class(EAppError)
.global g0 C: EConvertError
.routine f0 Fail(const Why: string)
  .var v0 Why: string const param
  .var v1 E: EAppError local
  assign @15 R+
    var v1 E
    new EConfigError
      var v0 Why: string
  assign @16 R+
    member string Message
      var v1 E: EAppError
    binary string
      member string Message
        var v1 E: EAppError
      + string str
        const string "!"
  writeln @17
    arg
      member string ClassName
        var v1 E: EAppError
    arg
      const string ": "
    arg
      member string Message
        var v1 E: EAppError
  raise @18
    var v1 E: EAppError
.routine <main>
  assign @24 R+
    global g0 C
    new EConvertError
      const string "x"
  writeln @25
    arg
      binary Boolean
        member string Value
          global g0 C: EConvertError
        = Boolean str
          const string ""
    arg
      const Char #32
    arg
      builtin Length Integer
        member string StackTrace
          global g0 C: EConvertError
  assert @26 "C <> nil"
    binary Boolean
      global g0 C: EConvertError
      <> Boolean ref
        const EConvertError nil
  expr @27
    call f0 Fail: -
      const string "stop"
