program DumpExceptions
.type EAppError = class(Exception) ref
.type EConfigError = class(EAppError) ref
.global g0 C: EConvertError
.routine f0 Fail(const Why: string)
  .var v0 Why: string const param
  .var v1 E: EAppError local
  assign @15 R+
    var v1 E
    create EConfigError builtin
      var v0 Why: string
  assign @16 R+
    objfield string FMessage #0
      var v1 E: EAppError
    binary string
      objfield string FMessage #0
        var v1 E: EAppError
      + string str
        const string "!"
  writeln @17
    arg
      builtin ClassName string
        var v1 E: EAppError
    arg
      const string ": "
    arg
      objfield string FMessage #0
        var v1 E: EAppError
  raise @18
    var v1 E: EAppError
.routine <main>
  assign @24 R+
    global g0 C
    create EConvertError builtin
      const string "x"
  writeln @25
    arg
      binary Boolean
        objfield string FValue #2
          global g0 C: EConvertError
        = Boolean str
          const string ""
    arg
      const Char #32
    arg
      builtin Length Integer
        member string StackTrace
          global g0 C: EConvertError
  assert @26 "C <> nil"
    binary Boolean
      probe value #0 EConvertError
        global g0 C: EConvertError
      <> Boolean ref
        const EConvertError nil
    probe #0 EConvertError "C"
  expr @27
    call f0 Fail: -
      const string "stop"
