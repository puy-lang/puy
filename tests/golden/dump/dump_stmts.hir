  assign @21 R+
    var v0 A
    var v1 B: Integer
  assign @22 R+
    var v1 B
    var v4 T: Integer
  assign @23 R+
    var v3 Count
    convert narrow Byte R+
      builtin Length Integer
        var v2 Tag: string
.routine <init>
  assign @8 R+ init
    global g0 G
    const Integer 10
.routine <main>
  .var v0 B: Byte local
  .var v1 C: Char local
  .var v2 U: UInt64 local
  .var v3 -: Int64 hidden
  .var v4 I: Char for var
  .var v5 J: Integer for var
  assign @27 R+
    global g1 S
