  inc @32 calc=Integer Q+R+
    var v0 B
    const Integer 2
  dec @33 calc=Integer Q+R+
    global g0 G
  expr @34
    call f1 Swap: -
      ref
        global g0 G
      ref
        global g0 G
      global g1 S: string
      out
        var v0 B
  if @35
    cond
      binary Boolean
        binary Boolean
          global g0 G: Integer
          > Boolean int:Integer
            const Integer 0
        and Boolean bool
          binary Boolean
            var v0 B: Byte
            < Boolean int:Integer
              const Integer 3
    then
      writeln @36
        arg
          call f0 Square: Integer
            global g0 G: Integer
        width
          const Int64 5
        arg
          const Char #32
        arg
          builtin UIntToStr string
            var v2 U: UInt64
        arg
          convert int->bool
            global g0 G: Integer
        arg
          convert ord->Integer
            var v1 C: Char
        arg
          unary neg Integer int:Integer
            global g0 G: Integer
        arg
          unary not Integer int:Integer
            var v0 B: Byte
    cond
      binary Boolean
        global g1 S: string
        = Boolean str
          convert char->string
            var v1 C: Char
    then
      halt @38
        const Integer 1
    else
      exit @40
  while @41
    cond
      binary Boolean
        global g0 G: Integer
        > Boolean int:Integer
          const Integer 0
    body
      dec @42 calc=Integer Q+R+
        global g0 G
  repeat @43
    body
      inc @44 calc=Integer Q+R+
        global g0 G
      if @45
        cond
          binary Boolean
            global g0 G: Integer
            = Boolean int:Integer
              const Integer 2
        then
          break @45
    until
      binary Boolean
        global g0 G: Integer
        >= Boolean int:Integer
          const Integer 3
  for @47 to Q+R+
    global g0 G counter=v3
    from
      const Integer 1
    to
      const Integer 3
    body
      write @48
        arg
          global g0 G: Integer
  for @49 to Q+R+
    var v4 I
    from
      const Char #97
    to
      const Char #99
    body
      continue @50
  for @51 downto Q+R+
    var v5 J
    from
      const Integer 3
    to
      const Integer 1
    body
      block @52
  readln @53
    global g1 S
  readln @54
  assert @55 "G < 5"
    binary Boolean
      global g0 G: Integer
      < Boolean int:Integer
        const Integer 5
    binary string
      const string "G is "
      + string str
        builtin IntToStr string
          global g0 G: Int64
  nop @58
  nop @60
  writeln @61
    arg
