    LINE_COMMENT@28..114 "// The CST of generic declarations (generics.md 1.1 to 1.3, 1.5): type parameters with"
    NEWLINE@114..115 "\n"
    LINE_COMMENT@115..197 "// constraints separated by `,` and groups separated by `;`, nested type arguments"
    NEWLINE@197..198 "\n"
    LINE_COMMENT@198..289 "// (`TList<TList<Integer>>`), a `>=` closing type arguments split into `>` and `=`, generic"
    NEWLINE@289..290 "\n"
    LINE_COMMENT@290..380 "// method headings and implementation headings. Only the CST is checked here; the semantic"
    NEWLINE@380..381 "\n"
    LINE_COMMENT@381..473 "// analysis reports the undeclared `TList` as E0700 and the empty bodies of the functions as"
    NEWLINE@473..474 "\n"
    LINE_COMMENT@474..483 "// E2001."
